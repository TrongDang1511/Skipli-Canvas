{
  "info": {
    "_postman_id": "skipli-canvas-auth-collection-2026",
    "name": "Skipli Canvas - Auth API (Automated Tests)",
    "description": "Postman Collection tự động hóa kiểm thử Module Auth của Skipli Canvas Backend. Tự động trích xuất accessToken và refreshToken từ response vào Collection Variables để các request sau tự sử dụng mà không cần truyền thủ công.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "testuser@skipli.dev",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "SkipliSecure123!",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register (Đăng ký tài khoản mới)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Tạo email ngẫu nhiên để tránh trùng lặp khi chạy automation test nhiều lần",
              "const randomId = Date.now().toString().slice(-6);",
              "const dynamicEmail = `tester_${randomId}@skipli.dev`;",
              "pm.collectionVariables.set('testEmail', dynamicEmail);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response structure is valid and contains tokens', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property('accessToken');",
              "    pm.expect(jsonData.data).to.have.property('refreshToken');",
              "    pm.expect(jsonData.data.user).to.have.property('id');",
              "    ",
              "    // Tự động lưu Token và User ID vào Collection Variables",
              "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
              "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
              "    pm.collectionVariables.set('userId', jsonData.data.user.id);",
              "    console.log('[Postman Test] Access Token and Refresh Token captured successfully.');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"displayName\": \"Skipli Automation Tester\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "description": "Đăng ký tài khoản người dùng mới. Script sẽ tự động bắt accessToken và refreshToken gán vào biến môi trường cho các request tiếp theo."
      },
      "response": []
    },
    {
      "name": "2. Login (Đăng nhập)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Login returns new tokens and user info', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.accessToken).to.be.a('string');",
              "    pm.expect(jsonData.data.refreshToken).to.be.a('string');",
              "    ",
              "    // Cập nhật lại Token vào Collection Variables",
              "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
              "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
              "    console.log('[Postman Test] Login successful. Tokens updated in variables.');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Đăng nhập bằng tài khoản vừa tạo để lấy cặp Access Token + Refresh Token mới."
      },
      "response": []
    },
    {
      "name": "3. Get Me (Lấy thông tin tài khoản - Protected API)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns correct user profile from token', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.id).to.eql(pm.collectionVariables.get('userId'));",
              "    pm.expect(jsonData.data.email).to.eql(pm.collectionVariables.get('testEmail'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        },
        "description": "Lấy thông tin tài khoản hiện tại. Request tự động sử dụng biến {{accessToken}} đã được gán ở bước trước."
      },
      "response": []
    },
    {
      "name": "4. Refresh Token (Cấp mới Access Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns rotated access and refresh tokens', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property('accessToken');",
              "    pm.expect(jsonData.data).to.have.property('refreshToken');",
              "    ",
              "    // Cập nhật lại Token mới sau khi xoay vòng (Token Rotation)",
              "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
              "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
              "    console.log('[Postman Test] Token rotated and updated successfully.');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/refresh-token",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh-token"]
        },
        "description": "Gửi Refresh Token để cấp mới Access Token mà không cần người dùng nhập lại mật khẩu."
      },
      "response": []
    },
    {
      "name": "5. Test Unauthorized (Kiểm tra chặn khi không có Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Returns error message about missing token', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.error).to.include('Access token missing');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        },
        "description": "Kiểm tra Middleware authenticate hoạt động chính xác bằng cách gọi API /api/auth/me mà KHÔNG truyền header Authorization. Kỳ vọng trả về HTTP 401."
      },
      "response": []
    },
    {
      "name": "6. Logout (Đăng xuất)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Logout successfully and clear tokens', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    ",
              "    // Xoá token khỏi biến môi trường",
              "    pm.collectionVariables.set('accessToken', '');",
              "    pm.collectionVariables.set('refreshToken', '');",
              "    console.log('[Postman Test] Logged out. Tokens cleared.');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        },
        "description": "Đăng xuất tài khoản và vô hiệu hóa Refresh Token trên Firestore."
      },
      "response": []
    }
  ]
}
