PORT=5000
NODE_ENV=development

# GoClaw AI Engine Configuration
GOCLAW_URL=http://localhost:18790
GOCLAW_GATEWAY_TOKEN=your_goclaw_gateway_token_here
GOCLAW_AGENT_ID=tho-xay-web-2
GOCLAW_WORKSPACE_DIR=

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# JWT Configuration (Dual Token Strategy: Access Token 15m + Refresh Token 7d)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 / MinIO Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=skipli-canvas-storage
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_FORCE_PATH_STYLE=true
